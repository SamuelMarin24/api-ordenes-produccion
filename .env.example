# Copia este archivo como .env y ajusta los valores a tu entorno.
# NUNCA subas el .env al repositorio: contiene credenciales reales.

# ── Base de datos ─────────────────────────────────────────────
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=NOMBRE_SERVIDOR\INSTANCIA
DB_DATABASE=nombre_base
DB_USER=usuario
DB_PASSWORD=contrasena

# Tabla origen de las ordenes (la alimenta el ERP)
TABLA_ORDENES=dbo.ordenes_produccion

# ── Parametros de negocio ─────────────────────────────────────
CENTRO_OPERACION=PRINCIPAL
DESDE_BASE=2025-01-01

# ── Operacion de la copia en memoria ──────────────────────────
MINUTOS_REVISION=15
HORA_CARGA_DIARIA=7
ARCHIVO_RESPALDO=respaldo_ordenes.json
UTC_OFFSET=-5

# ── Seguridad ─────────────────────────────────────────────────
# Genera una llave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Avisos por correo (opcional, solo Windows con Outlook) ────
CORREO_ACTIVO=false
CORREO_DESTINO=
